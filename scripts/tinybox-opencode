#!/bin/sh
set -eu

workspace=${1:-.}
shift || true
: "${TINYBOX_BIN:=tinybox}"
: "${TINYBOX_DAEMON:=127.0.0.1:8080}"

if [ ! -f "$workspace/.opencode/tools/bash.ts" ]; then
    echo "missing OpenCode adapter; run scripts/install_opencode_adapter.sh '$workspace'" >&2
    exit 1
fi
task_id=$($TINYBOX_BIN agent run "$workspace" --daemon "$TINYBOX_DAEMON" --detach)
cleanup() {
    $TINYBOX_BIN agent destroy "$task_id" >/dev/null 2>&1 || true
}
trap cleanup EXIT HUP INT TERM
TINYBOX_TASK_ID=$task_id TINYBOX_BIN=$TINYBOX_BIN opencode "$workspace" "$@"
